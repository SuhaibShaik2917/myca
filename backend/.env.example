ENVIRONMENT=development
PROJECT_NAME=MyCA
VERSION=1.0.0
API_V1_STR=/api/v1

DATABASE_URL=postgresql+psycopg://app_service_user:change-me@localhost:5432/myca
DATABASE_WORKER_URL=postgresql+psycopg://worker_service_user:change-me@localhost:5432/myca

SECRET_KEY=change-me-to-a-long-random-secret-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
