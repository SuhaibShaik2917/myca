# MyCA Production Environment Configuration Template
# Copy to `.env.production` and fill real secret manager values before running Docker Compose.

ENVIRONMENT=production
ALLOW_DEMO_TOKENS=false
ALLOW_DEV_HEADER_AUTH=false

# PostgreSQL 16 Role Credentials (least-privilege runtime roles vs admin migration role)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<REPLACE_WITH_STRONG_POSTGRES_PASSWORD>
POSTGRES_DB=myca
DATABASE_URL=postgresql+psycopg://app_service_user:<REPLACE_APP_ROLE_PASSWORD>@db:5432/myca
DATABASE_WORKER_URL=postgresql+psycopg://worker_service_user:<REPLACE_WORKER_ROLE_PASSWORD>@db:5432/myca
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:<REPLACE_WITH_STRONG_POSTGRES_PASSWORD>@db:5432/myca
WORKER_ORG_ID=<REPLACE_WITH_TARGET_ORGANIZATION_UUID>

# Cryptographic Signing Keys (must be distinct, >= 32 characters, never contain default/test markers)
SECRET_KEY=<REPLACE_WITH_MIN_32_CHAR_RANDOM_JWT_SIGNING_SECRET>
GSTR3B_REVIEW_ATTESTATION_KEY=<REPLACE_WITH_DISTINCT_MIN_32_CHAR_ATTESTATION_SECRET>
STATUTORY_AUDIT_SIGNING_KEY=<REPLACE_WITH_DISTINCT_MIN_32_CHAR_AUDIT_SIGNING_SECRET>

# CORS (production/staging requires https:// origins; wildcard '*' is rejected at startup)
CORS_ORIGINS=["https://app.example.com"]
TRUSTED_PROXIES=["127.0.0.1","::1"]

# Federated OIDC Identity Provider (Authorization Code + PKCE)
MYCA_IDP_PROVIDER=google
MYCA_IDP_ISSUER=https://accounts.google.com
MYCA_IDP_AUDIENCE=<REPLACE_WITH_OIDC_CLIENT_ID>
MYCA_IDP_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
MYCA_IDP_TOKEN_URL=https://oauth2.googleapis.com/token
MYCA_IDP_CLIENT_SECRET=<REPLACE_WITH_OIDC_CLIENT_SECRET>
MYCA_IDP_REDIRECT_URIS=["https://app.example.com/auth/callback"]

# Document Storage (set STORAGE_BACKEND=s3 for distributed multi-replica ECS/Kubernetes deployments)
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=/app/storage
AWS_S3_BUCKET_NAME=
AWS_REGION=ap-south-1
AWS_S3_KMS_KEY_ID=

# GSP / GSTN Gateway (`sandbox` uses local simulated ARN/CIN; `live` fails closed unless licensed GSP credentials exist)
GSP_MODE=sandbox
GSTN_GSP_BASE_URL=
GSTN_GSP_CLIENT_ID=
GSTN_GSP_CLIENT_SECRET=

# Gemini AI Copilot & OCR Extraction (required in production unless explicitly stubbed for CI)
GEMINI_API_KEY=<REPLACE_WITH_GEMINI_API_KEY>
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
