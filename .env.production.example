# =================================================================
# MyCA Production Environment Configuration Template
# =================================================================

# Server & Environment
ENVIRONMENT=production
PROJECT_NAME="MyCA Financial Platform"
VERSION=1.0.0
PORT=8000
WORKERS=4

# Database Connections
# Application user (least-privilege, RLS enforced)
DATABASE_URL=postgresql://app_service_user:REPLACE_WITH_STRONG_PASSWORD@db:5432/myca

# Migration Admin (Alembic DDL owner)
MIGRATION_DATABASE_URL=postgresql://postgres:REPLACE_WITH_ADMIN_PASSWORD@db:5432/myca

# Database Superuser for Docker Compose initialization
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_ADMIN_PASSWORD
POSTGRES_DB=myca

# Security & Cryptography
# Generate via: openssl rand -hex 32
SECRET_KEY=REPLACE_WITH_64_CHAR_HEX_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Configuration (JSON array of allowed frontend origins)
CORS_ORIGINS=["https://app.myca.in", "https://portal.myca.in", "http://localhost:5173", "http://localhost:80"]

# GSTN & GSP Gateway Credentials (Production vs Sandbox)
# Set to 'false' ONLY when deploying with authorized live GSP certificates
GSP_SANDBOX_MODE=true
GSTN_GSP_CLIENT_ID=REPLACE_WITH_AUTHORIZED_GSP_CLIENT_ID
GSTN_GSP_CLIENT_SECRET=REPLACE_WITH_AUTHORIZED_GSP_CLIENT_SECRET
GSTN_ENVIRONMENT=production

# Banking Open API Partner Integration
BANKING_API_BASE_URL=https://api.bankingpartner.in/v1
BANKING_API_KEY=REPLACE_WITH_BANKING_PARTNER_API_KEY
BANKING_API_SECRET=REPLACE_WITH_BANKING_PARTNER_API_SECRET

# AI & LLM Copilot (Google Gemini API)
# Get from: https://aistudio.google.com/
GEMINI_API_KEY=REPLACE_WITH_GOOGLE_GEMINI_API_KEY

# Storage Configuration
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=/app/storage
# For AWS S3:
# STORAGE_BACKEND=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET_NAME=myca-production-documents
# AWS_REGION=ap-south-1
